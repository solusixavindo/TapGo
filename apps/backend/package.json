{
  "name": "@tapgo/backend",
  "version": "1.0.0-alpha",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "seed:admin": "tsx prisma/seed-admin.ts",
    "seed:uat": "tsx prisma/seed-uat-credentials.ts",
    "seed:founder-platinum": "tsx ../../scripts/seed-founder-platinum.ts",
    "seed:founder-chairman": "tsx ../../scripts/seed-founder-chairman.ts",
    "promote:admin": "tsx prisma/promote-admin.ts",
    "audit:production-data": "tsx ../../scripts/audit-production-data.ts",
    "cleanup:prelaunch": "tsx ../../scripts/pre-launch-cleanup.ts",
    "doku:capture-webhook": "tsx ../../scripts/capture-doku-webhook.ts",
    "admin:vip-bootstrap": "tsx scripts/super-admin-vip-bootstrap.ts",
    "admin:owner-bootstrap": "tsx scripts/owner-account-bootstrap.ts",
    "admin:scope-bootstrap": "tsx scripts/admin-scope-bootstrap.ts",
    "audit:leaked-seed": "tsx scripts/leaked-seed-credential-audit.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prisma": "^5.22.0",
    "rate-limit-redis": "^4.3.1",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.8.7",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitest/coverage-v8": "^2.1.4",
    "eslint": "^9.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
