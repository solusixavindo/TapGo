# TapGo Backend Production/UAT Environment
# Copy to apps/backend/.env on the VPS and replace every CHANGE_ME value.

NODE_ENV=production
HOST=0.0.0.0
PORT=4000

APP_URL=https://tapgolion.id
API_BASE_URL=https://api.tapgolion.id

DATABASE_URL=postgresql://tapgo:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/tapgo?schema=public
REDIS_URL=redis://127.0.0.1:6379

# JWT_SECRET is accepted as an alias for JWT_ACCESS_SECRET.
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_ACCESS_SECRET
JWT_ACCESS_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_REFRESH_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# CORS_ORIGIN is accepted as an alias, but CORS_ORIGINS supports comma-separated origins.
CORS_ORIGIN=https://tapgolion.id
CORS_ORIGINS=https://tapgolion.id,https://api.tapgolion.id

# Rute jarak Ojek Online. LOCAL = garis-lurus (default sebelumnya). OSRM =
# rute jalan asli via server demo publik OSRM — zero-setup, cukup untuk mulai
# (kebijakan pemakaian ringan, bukan untuk trafik besar jangka panjang).
# Untuk self-host sendiri nanti: jalankan scripts/osrm-setup.sh DI VPS INI
# (bukan di lingkungan dev), lalu ganti OSRM_BASE_URL ke http://localhost:5001.
RIDE_DISTANCE_PROVIDER=OSRM
OSRM_BASE_URL=https://router.project-osrm.org

# UAT uses Midtrans sandbox. Set true only when production keys are ready.
MIDTRANS_SERVER_KEY=SB-Mid-server-CHANGE_ME
MIDTRANS_CLIENT_KEY=SB-Mid-client-CHANGE_ME
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_NOTIFICATION_SECRET=CHANGE_ME_OPTIONAL_NOTIFICATION_SECRET
EXTERNAL_MEMBERSHIP_PAYMENTS_ENABLED=false

# DOKU payment gateway. Fill from the DOKU merchant dashboard; never commit real values.
DOKU_CLIENT_ID=CHANGE_ME
DOKU_SECRET_KEY=CHANGE_ME
DOKU_API_KEY=CHANGE_ME_IF_USED
DOKU_PUBLIC_KEY=CHANGE_ME_IF_USED
DOKU_MERCHANT_PUBLIC_KEY=CHANGE_ME_IF_USED
DOKU_ENABLED=true
DOKU_INTEGRATION_MODE=checkout
DOKU_ENVIRONMENT=sandbox
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_WEBHOOK_SECRET=CHANGE_ME_OPTIONAL_WEBHOOK_SECRET
DOKU_WEBHOOK_URL=https://api.tapgolion.id/api/v1/webhooks/doku
TAPGO_FOUNDER_CHAIRMAN_CONFIRM=
FOUNDER_CHAIRMAN_INITIAL_PASSWORD=CHANGE_ME_SECURE_LOCAL_ONLY
FOUNDER_CHAIRMAN_ACTOR_ID=CHANGE_ME_OPTIONAL_SUPER_ADMIN_ID
FOUNDER_CHAIRMAN_BANK_NAME=
FOUNDER_CHAIRMAN_BANK_ACCOUNT_NAME=
FOUNDER_CHAIRMAN_BANK_ACCOUNT_NUMBER=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FIREBASE_PROJECT_ID=
GOOGLE_MAPS_API_KEY=

# Stage R2.7 PPOB. WAJIB "disabled" sampai integrasi provider nyata (R2.8) lulus UAT.
PPOB_PROVIDER=disabled

# Stage R2.8. WAJIB diisi bersama PPOB_PROVIDER=digiflazz setelah UAT sandbox lulus.
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_TESTING=false
DIGIFLAZZ_WEBHOOK_SECRET=
PPOB_RECONCILE_ENABLED=false
PPOB_RECONCILE_INTERVAL_MS=60000

# Sentry (crash reporting). Kosong = Sentry.init() tidak dipanggil sama
# sekali (fail-closed, sama seperti PPOB_PROVIDER=disabled) — aman dibiarkan
# kosong sampai project Sentry benar-benar dibuat.
SENTRY_DSN=

# Direktori file log tambahan (error.log, audit.log) di samping stdout —
# lihat src/core/logger/logger.ts. Kosong = perilaku lama (stdout saja),
# cocok untuk `docker logs`/journal. Isi (mis. /var/log/tapgo) hanya bila
# VPS ini juga memakai logrotate (lihat infra/logrotate/tapgo-backend) untuk
# rotasi harian; pastikan direktori tersebut sudah ada dan bisa ditulis oleh
# user yang menjalankan container.
LOG_DIR=

# Backup database otomatis ke Cloudflare R2 (lihat scripts/backup-db.sh +
# infra/cron/tapgo-backup.cron). Dibaca skrip bash secara langsung, BUKAN
# oleh proses Node — taruh di file env terpisah yang di-source cron (lihat
# komentar di infra/cron/tapgo-backup.cron), bukan wajib ada di .env ini.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
BACKUP_RETENTION_DAYS=7
