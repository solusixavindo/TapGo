# TapGo Backend Production/UAT Environment
# Copy to apps/backend/.env on the VPS and replace every CHANGE_ME value.

NODE_ENV=production
HOST=0.0.0.0
PORT=4000

APP_URL=https://tapgolion.id
API_BASE_URL=https://api.tapgolion.id

DATABASE_URL=postgresql://tapgo:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/tapgo?schema=public
REDIS_URL=redis://127.0.0.1:6379

# JWT_SECRET is accepted as an alias for JWT_ACCESS_SECRET.
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_ACCESS_SECRET
JWT_ACCESS_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_REFRESH_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# CORS_ORIGIN is accepted as an alias, but CORS_ORIGINS supports comma-separated origins.
CORS_ORIGIN=https://tapgolion.id
CORS_ORIGINS=https://tapgolion.id,https://api.tapgolion.id

# --- Domain secrets (WAJIB, minimum 32 karakter, dan HARUS berbeda satu sama lain)
#
# Ketiga secret di bawah sebelumnya tidak tercantum di berkas contoh ini sama
# sekali. Karena penegakannya fail-closed pada titik pemakaian (bukan saat boot),
# deploy tanpa mereka TIDAK gagal start — tetapi membuat dua fitur mati permanen
# dengan 503 tanpa penjelasan:
#
#   MEMBERSHIP_DOCUMENT_SECRET tidak ada -> unggahan KTP/swafoto selalu 503,
#     sehingga alur verifikasi dokumen R2.6 tidak dapat dijalankan sama sekali.
#   AUTH_RECOVERY_HMAC_SECRET tidak ada  -> pemulihan password selalu 503.
#
# Setiap secret SENGAJA terpisah: kebocoran satu domain tidak boleh melemahkan
# domain lain. JANGAN memakai nilai yang sama untuk dua variabel.
#
# Bangkitkan masing-masing dengan:  openssl rand -base64 48
MEMBERSHIP_DOCUMENT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_DOCUMENT_SECRET
AUTH_RECOVERY_HMAC_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_RECOVERY_SECRET

# Blind index identifier (NIK/plat). Maksimal dua versi aktif untuk rotasi.
# IDENTIFIER_INDEX_KEY_V2 diisi hanya saat rotasi sedang berjalan.
IDENTIFIER_INDEX_KEY_CURRENT_VERSION=1
IDENTIFIER_INDEX_KEY_V1=CHANGE_ME_MINIMUM_32_CHARACTERS_IDENTIFIER_KEY
# IDENTIFIER_INDEX_KEY_V2=

# Masa simpan dokumen identitas (jam). Keputusan Owner: 24 jam untuk KEDUANYA.
# Nilainya wajib tetap sama; ada uji yang menjaga agar keduanya tidak bergeser
# diam-diam. Maksimum yang diterima schema adalah 72.
MEMBERSHIP_DOCUMENT_RETENTION_HOURS=24
DRIVER_DOCUMENT_RETENTION_HOURS=24

# --- Rate limiting
#
# Tanpa RATE_LIMIT_REDIS_URL, rate limiter memakai penyimpanan dalam memori
# per-proses. Di deployment multi-proses (PM2 cluster / beberapa instance) batas
# efektifnya berlipat sejumlah proses, dan setiap restart mereset hitungannya —
# tepat pada kontrol yang menahan brute-force password dan pengeboman OTP.
# Kosongkan HANYA untuk deployment satu proses.
RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379

# --- Kanal & fitur (semua fail-closed; false berarti tertutup)
#
# EXTERNAL_MEMBERSHIP_PAYMENTS_ENABLED adalah master switch: bila false, ketiga
# kanal pembelian di bawah ikut mati apa pun nilainya.
EXTERNAL_MEMBERSHIP_PAYMENTS_ENABLED=false
# Pembelian membership lewat web (Jalur A R2.6).
MEMBERSHIP_PURCHASE_WEB_ENABLED=false
# Pembelian di dalam aplikasi mobile. WAJIB false untuk rilis Google Play:
# pembelian in-app menuntut Play Billing.
MEMBERSHIP_PURCHASE_APP_ENABLED=false
# Pencairan saldo wallet. Terpisah penuh dari pembelian membership — dulu
# keduanya berbagi satu flag, sehingga menyalakan penjualan web ikut membuka
# pencairan saldo di rilis Play.
WALLET_CASH_OUT_ENABLED=false
# Realtime/Socket.IO. Biarkan false sampai autentikasi socket terpasang.
REALTIME_ENABLED=false

# UAT uses Midtrans sandbox.
#
# MIDTRANS_IS_PRODUCTION mengarahkan permintaan ke endpoint Snap produksi atau
# sandbox. Nilainya HANYA "true" atau "false" — nilai lain ditolak saat boot.
MIDTRANS_SERVER_KEY=SB-Mid-server-CHANGE_ME
MIDTRANS_CLIENT_KEY=SB-Mid-client-CHANGE_ME
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_NOTIFICATION_SECRET=CHANGE_ME_OPTIONAL_NOTIFICATION_SECRET

# DOKU payment gateway. Fill from the DOKU merchant dashboard; never commit real values.
DOKU_CLIENT_ID=CHANGE_ME
DOKU_SECRET_KEY=CHANGE_ME
DOKU_API_KEY=CHANGE_ME_IF_USED
DOKU_PUBLIC_KEY=CHANGE_ME_IF_USED
DOKU_MERCHANT_PUBLIC_KEY=CHANGE_ME_IF_USED
DOKU_ENABLED=true
DOKU_INTEGRATION_MODE=checkout
DOKU_ENVIRONMENT=sandbox
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_WEBHOOK_SECRET=CHANGE_ME_OPTIONAL_WEBHOOK_SECRET
DOKU_WEBHOOK_URL=https://api.tapgolion.id/api/v1/webhooks/doku
TAPGO_FOUNDER_CHAIRMAN_CONFIRM=
FOUNDER_CHAIRMAN_INITIAL_PASSWORD=CHANGE_ME_SECURE_LOCAL_ONLY
FOUNDER_CHAIRMAN_ACTOR_ID=CHANGE_ME_OPTIONAL_SUPER_ADMIN_ID
FOUNDER_CHAIRMAN_BANK_NAME=
FOUNDER_CHAIRMAN_BANK_ACCOUNT_NAME=
FOUNDER_CHAIRMAN_BANK_ACCOUNT_NUMBER=

# --- Seed akun demo (JANGAN disetel di production)
#
# `npm run db:seed` menuntut ketiga variabel ini dan gagal tanpa mereka.
# Password ini dulu ditanam harfiah di prisma/seed.ts — berkas yang ter-track di
# Git — sehingga akun SUPER_ADMIN yang dibuatnya memakai password yang dapat
# dibaca siapa pun yang memegang salinan repositori.
#
# Seed demo tidak punya tempat di production. Biarkan ketiganya KOSONG di sini
# supaya `db:seed` gagal terang-terangan bila terpanggil di server produksi.
# Untuk memeriksa apakah akun seed lama masih ada dan masih memakai password
# bocornya:  npm --workspace apps/backend run audit:leaked-seed
SEED_ADMIN_PASSWORD=
SEED_DRIVER_PASSWORD=
SEED_USER_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FIREBASE_PROJECT_ID=
GOOGLE_MAPS_API_KEY=
