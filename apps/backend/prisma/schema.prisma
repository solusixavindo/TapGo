generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  DRIVER
  ADMIN
  SUPER_ADMIN
  /// Role puncak pemilik sistem. Memenuhi seluruh penjaga SUPER_ADMIN lewat
  /// tangga role di core/security/roleHierarchy.ts, dan hanya dapat dibuat
  /// lewat CLI bootstrap — tidak pernah lewat API, migration, atau seed.
  ///
  /// Tetap BUKAN kewenangan: pengelolaan scope masih menuntut grant
  /// ADMIN_SCOPE_MANAGE aktif, dan tidak ada bypass ke jalur driver.
  SUPER_ADMIN_VIP
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DELETED
}

enum DriverStatus {
  OFFLINE
  AVAILABLE
  ON_TRIP
  SUSPENDED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum RideStatus {
  REQUESTED
  MATCHING
  DRIVER_ASSIGNED
  DRIVER_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  CASH
  WALLET
  MIDTRANS
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  EXPIRED
  REFUNDED
  CANCELLED
}

enum MembershipOrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

/// Kanal asal order membership (Stage R2.6 jalur A).
///
/// Dipakai untuk audit: pembelian mana yang datang dari web, dari aplikasi
/// mobile, atau dari konfirmasi manual admin. Kolomnya nullable karena order
/// yang dibuat sebelum stage ini memang tidak diketahui kanalnya — memberi
/// nilai tebakan pada baris lama berarti mengarang riwayat.
enum MembershipOrderChannel {
  WEB
  APP
  ADMIN
}

enum UserMembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum MembershipDocumentType {
  KTP
  SELFIE
}

enum MembershipDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WalletTransactionType {
  TOPUP
  PAYMENT
  REFUND
  WITHDRAWAL
  WITHDRAWAL_REQUEST
  WITHDRAWAL_REFUND
  COMMISSION
  REGISTRATION_BONUS
  BASIC_SPONSOR_BONUS
  SPONSOR_BONUS
  LEVEL_BONUS
  REWARD_BONUS
  PPOB_BENEFIT
  /// Debit pembelian PPOB dan kompensasi pengembaliannya (Stage R2.7).
  PPOB_PURCHASE
  PPOB_REFUND
  PROFIT_SHARING
  PROFIT_SHARING_BONUS
  ADJUSTMENT
}

enum ChatSenderType {
  USER
  DRIVER
  ADMIN
}

enum MembershipTier {
  BASIC
  SILVER
  GOLD
  PLATINUM
}

enum ReferralStatus {
  ACTIVE
  BLOCKED
}

enum CommissionType {
  DIRECT_REFERRAL
  BASIC_SPONSOR_BONUS
  SPONSOR_BONUS
  LEVEL_BONUS
  LEVEL_COMMISSION
  REWARD_BONUS
  PROFIT_SHARING
  PROFIT_SHARING_BONUS
  MEMBERSHIP_UPGRADE
  ADMIN_ADJUSTMENT
}

enum CommissionStatus {
  PENDING
  POSTED
  REVERSED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum ProfitSharingPeriodStatus {
  DRAFT
  APPROVED
  DISTRIBUTED
  CANCELLED
