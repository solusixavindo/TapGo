  registrationEvent RegistrationEvent? @relation(fields: [registrationEventId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([registrationEventId])
  @@index([flagType, status])
  @@index([severity, status])
  @@index([createdAt])
  @@map("abuse_flags")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(80)
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// P1-4: counter atomik untuk benefit registrasi berkuota (mis. Basic PPOB
// Rp5.000 untuk 1.000 user pertama). Slot diklaim via conditional UPDATE
// (row lock) sehingga aman dari race. CHECK constraint di-manage pada migration.
model RegistrationQuota {
  key       String   @id
  limit     Int
  granted   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("registration_quota")
}

// ===========================================================================
// RELEASE 2 — RIDE DOMAIN (Stage 5.2)
//
// Seluruh model di bawah bersifat ADDITIVE dan memakai prefix `Ride` agar
// tidak bertabrakan dengan model legacy (`Ride`, `Driver`, `Payment`, dst.
// dari 0001_init) yang tetap dipertahankan sebagai compatibility boundary
// read-only dan TIDAK ditulis oleh domain baru ini.
//
// Aturan uang: seluruh nominal tarif memakai Int = integer rupiah penuh
// (bukan Decimal/float), sesuai keputusan Stage 5.2.
//
// Privasi: nomor plat TIDAK disimpan plaintext (hash + versi ter-mask).
// Koordinat presisi disimpan hanya untuk keperluan operasional dan tidak
// boleh ditulis ke log (lihat docs/backend/ride-domain.md).
// ===========================================================================

enum RideServiceType {
  MOTORCYCLE
  CAR
}

enum RideDriverStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum RideDriverAvailability {
  OFFLINE
  ONLINE
  BUSY
}

enum RideVehicleVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RideOrderStatus {
  CREATED
  SEARCHING_DRIVER
  DRIVER_ASSIGNED
  DRIVER_TO_PICKUP
  DRIVER_ARRIVED
  IN_TRIP
  COMPLETED
  CANCELLED_BY_PASSENGER
  CANCELLED_BY_DRIVER
  CANCELLED_BY_SYSTEM
  NO_DRIVER
  EXPIRED
  // Dicadangkan oleh kontrak Stage 5.2. TIDAK dipakai pada tahap ini karena
  // pembayaran digital fail-closed; status pembayaran hidup pada
  // RideOrder.paymentState (domain terpisah).
  PAYMENT_FAILED
}

enum RidePaymentMethod {
  CASH
  DIGITAL
}

/// State pembayaran ride — domain TERPISAH dari RideOrderStatus.
enum RidePaymentState {
  /// Pembayaran digital belum dikonfigurasi (fail-closed pada Stage 5.2).
  NOT_CONFIGURED
  /// Tunai diharapkan, belum ada rekonsiliasi.
  CASH_EXPECTED
  /// Driver melapor tunai diterima — BUKAN saldo digital.
  CASH_REPORTED
  FAILED
}

enum RideEventType {
  QUOTE_CREATED
  ORDER_CREATED
  MATCHING_STARTED
  DRIVER_ASSIGNED
  DRIVER_REJECTED_OFFER
  STATUS_CHANGED
  CANCELLED
  NO_DRIVER
  EXPIRED
  CASH_REPORTED
  LOCATION_REJECTED
}

enum RideActorRole {
  PASSENGER
  DRIVER
  SYSTEM
  ADMIN
}

enum RideCancellationReason {
  WAIT_TOO_LONG
  DRIVER_NOT_MOVING
  CHANGE_OF_PLAN
  WRONG_PICKUP
  FOUND_OTHER_TRANSPORT
  PASSENGER_UNREACHABLE
  VEHICLE_PROBLEM
  SYSTEM_TIMEOUT
  OTHER
}

/// Siklus pengajuan driver (Stage 5.14B). Terpisah dari RideDriverStatus:
/// SUSPENDED BUKAN status aplikasi — itu milik RideDriverProfile.
/// Open states: DRAFT, SUBMITTED, UNDER_REVIEW.
/// Terminal states: APPROVED, REJECTED, WITHDRAWN.
enum RideDriverApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

/// Satu siklus pengajuan driver. Histori dipertahankan: resubmission membuat
/// baris baru, bukan mengubah baris lama.
///
/// Objek database berikut dibuat lewat raw SQL pada migration karena Prisma
/// tidak dapat merepresentasikannya secara deklaratif — JANGAN dihapus saat
/// mengedit model ini:
///   - ride_driver_applications_one_open_per_user_key  (partial unique index:
///     satu open application per user, WHERE status IN DRAFT/SUBMITTED/UNDER_REVIEW)
///   - ride_driver_applications_cycle_number_check
///   - ride_driver_applications_version_check
///   - ride_driver_applications_approved_at_check
///   - ride_driver_applications_rejected_at_check
///   - ride_driver_applications_withdrawn_at_check
///   - ride_driver_applications_terminal_exclusive_check
///
/// Stage 5.14B adalah schema foundation saja: belum ada service, endpoint,
/// maupun penegakan transisi status. Validasi transisi menjadi tanggung jawab
/// application service pada stage berikutnya.
model RideDriverApplication {
  id          String                      @id @default(uuid()) @db.Uuid
  userId      String                      @map("user_id") @db.Uuid
  /// Nomor siklus monotonik per user, dimulai dari 1.
  cycleNumber Int                         @map("cycle_number")
  status      RideDriverApplicationStatus @default(DRAFT)
  /// Optimistic lock untuk service Stage 5.14C.
  version     Int                         @default(0)

  submittedAt        DateTime? @map("submitted_at")
  approvedAt         DateTime? @map("approved_at")
  rejectedAt         DateTime? @map("rejected_at")
  withdrawnAt        DateTime? @map("withdrawn_at")
  /// Kode alasan keputusan yang dibatasi panjangnya — BUKAN teks bebas dan
  /// BUKAN pesan exception. Kosakata kode ditegakkan application service.
  decisionReasonCode String?   @map("decision_reason_code") @db.VarChar(60)

  // --- Review claim/lease (Stage R2.2) --------------------------------
  /// Admin yang sedang memegang klaim review. Restrict, bukan Cascade:
  /// menghapus akun reviewer tidak boleh menghapus jejak review.
  claimedById       String?   @map("claimed_by_id") @db.Uuid
  claimedAt         DateTime? @map("claimed_at")
  /// Batas lease. SELALU dihitung database lewat now() + interval, tidak
  /// pernah dari jam client maupun Node.
  claimExpiresAt    DateTime? @map("claim_expires_at")
  releasedAt        DateTime? @map("released_at")
  /// Kode alasan pelepasan yang dibatasi, bukan teks bebas.
  releaseReasonCode String?   @map("release_reason_code") @db.VarChar(60)
  reviewedById      String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt        DateTime? @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// onDelete: Restrict (PostgreSQL ON DELETE RESTRICT) — DISENGAJA, jangan
  /// diubah menjadi Cascade. Histori pengajuan driver harus bertahan melewati
  /// penghapusan akun: keputusan retention dan legal hold bersifat fail-closed,
  /// dan record tidak boleh hilang diam-diam. Konsekuensinya hard-delete User
  /// yang memiliki application akan DITOLAK database. Itu perilaku yang
  /// diinginkan; penghapusan akun di TapGo berupa AccountDeletionRequest,
  /// bukan hard delete.
  user       User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  claimedBy  User? @relation("DriverApplicationClaimant", fields: [claimedById], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("DriverApplicationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@unique([userId, cycleNumber])
  @@index([status, createdAt])
  /// Antrian review dan pemindaian lease kedaluwarsa.
  @@index([status, claimExpiresAt])
  @@index([claimedById, claimExpiresAt])
  @@map("ride_driver_applications")
}

model RideDriverProfile {
  id            String                 @id @default(uuid()) @db.Uuid
  userId        String                 @unique @map("user_id") @db.Uuid
  status        RideDriverStatus       @default(PENDING)
  availability  RideDriverAvailability @default(OFFLINE)
  ratingAverage Decimal                @default(5.0) @map("rating_average") @db.Decimal(3, 2)
  ratingCount   Int                    @default(0) @map("rating_count")
  lastSeenAt    DateTime?              @map("last_seen_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles  RideVehicle[]
  orders    RideOrder[]          @relation("RideOrderDriver")
  locations RideDriverLocation[]

  @@index([status, availability])
  @@map("ride_driver_profiles")
}

model RideVehicle {
  id                 String                        @id @default(uuid()) @db.Uuid
  driverProfileId    String                        @map("driver_profile_id") @db.Uuid
  type               RideServiceType
  /// SHA-256 nomor plat — plaintext TIDAK disimpan.
  plateNumberHash    String                        @map("plate_number_hash") @db.VarChar(64)
  /// Versi ter-mask untuk tampilan, mis. "A 1234 ***".
  plateNumberMasked  String                        @map("plate_number_masked") @db.VarChar(32)
  brand              String?                       @db.VarChar(60)
  model              String?                       @db.VarChar(60)
  color              String?                       @db.VarChar(30)
  verificationStatus RideVehicleVerificationStatus @default(PENDING) @map("verification_status")
  isActive           Boolean                       @default(false) @map("is_active")
  createdAt          DateTime                      @default(now()) @map("created_at")
  updatedAt          DateTime                      @updatedAt @map("updated_at")

  driverProfile RideDriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  orders        RideOrder[]       @relation("RideOrderVehicle")

  @@unique([driverProfileId, plateNumberHash])
  @@index([driverProfileId, isActive])
  @@index([type, verificationStatus])
  @@map("ride_vehicles")
}

model RideQuote {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  serviceType RideServiceType @map("service_type")

  pickupLat      Decimal @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng      Decimal @map("pickup_lng") @db.Decimal(10, 7)
  pickupAddress  String  @map("pickup_address") @db.VarChar(255)
  dropoffLat     Decimal @map("dropoff_lat") @db.Decimal(10, 7)
  dropoffLng     Decimal @map("dropoff_lng") @db.Decimal(10, 7)
  dropoffAddress String  @map("dropoff_address") @db.VarChar(255)

  distanceMeters  Int @map("distance_meters")
  durationSeconds Int @map("duration_seconds")
  etaSeconds      Int @map("eta_seconds")

  // Komponen tarif — integer rupiah penuh.
  baseFare     Int @map("base_fare")
  distanceFare Int @map("distance_fare")
  serviceFee   Int @map("service_fee")
  subtotalFare Int @map("subtotal_fare")
  totalFare    Int @map("total_fare")

  fareRuleVersion String   @map("fare_rule_version") @db.VarChar(60)
  roundingRule    String   @map("rounding_rule") @db.VarChar(60)
  distanceSource  String   @map("distance_source") @db.VarChar(60)
  quoteVersion    Int      @default(1) @map("quote_version")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  order RideOrder?

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("ride_quotes")
}

model RideOrder {
  id              String          @id @default(uuid()) @db.Uuid
  /// Referensi publik yang dipakai di API/UI (bukan UUID internal).
  publicReference String          @unique @map("public_reference") @db.VarChar(24)
  passengerId     String          @map("passenger_id") @db.Uuid
  driverProfileId String?         @map("driver_profile_id") @db.Uuid
  vehicleId       String?         @map("vehicle_id") @db.Uuid
  /// Satu quote hanya boleh menghasilkan satu order (anti reuse).
  quoteId         String          @unique @map("quote_id") @db.Uuid
  serviceType     RideServiceType @map("service_type")
  status          RideOrderStatus @default(CREATED)

  // Snapshot lokasi (immutable setelah order dibuat).
  pickupLat      Decimal @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng      Decimal @map("pickup_lng") @db.Decimal(10, 7)
  pickupAddress  String  @map("pickup_address") @db.VarChar(255)
  dropoffLat     Decimal @map("dropoff_lat") @db.Decimal(10, 7)
  dropoffLng     Decimal @map("dropoff_lng") @db.Decimal(10, 7)
  dropoffAddress String  @map("dropoff_address") @db.VarChar(255)

  // Snapshot tarif authoritative (integer rupiah) — dikunci dari quote.
  distanceMeters  Int    @map("distance_meters")
  durationSeconds Int    @map("duration_seconds")
  baseFare        Int    @map("base_fare")
  distanceFare    Int    @map("distance_fare")
  serviceFee      Int    @map("service_fee")
  subtotalFare    Int    @map("subtotal_fare")
  totalFare       Int    @map("total_fare")
  fareRuleVersion String @map("fare_rule_version") @db.VarChar(60)

  paymentMethod RidePaymentMethod @default(CASH) @map("payment_method")
  paymentState  RidePaymentState  @default(CASH_EXPECTED) @map("payment_state")

  // Metadata pembatalan.
  cancelledByUserId  String?                 @map("cancelled_by_user_id") @db.Uuid
  cancelledByRole    RideActorRole?          @map("cancelled_by_role")
  cancellationReason RideCancellationReason? @map("cancellation_reason")
  cancellationNote   String?                 @map("cancellation_note") @db.VarChar(500)
  cancellationFee    Int?                    @map("cancellation_fee")
  cancellationPolicy String?                 @map("cancellation_policy") @db.VarChar(60)
  cancelledAt        DateTime?               @map("cancelled_at")

  assignedAt  DateTime? @map("assigned_at")
  arrivedAt   DateTime? @map("arrived_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  passenger     User                 @relation("RideOrderPassenger", fields: [passengerId], references: [id], onDelete: Cascade)
  driverProfile RideDriverProfile?   @relation("RideOrderDriver", fields: [driverProfileId], references: [id])
  vehicle       RideVehicle?         @relation("RideOrderVehicle", fields: [vehicleId], references: [id])
  quote         RideQuote            @relation(fields: [quoteId], references: [id])
  events        RideEvent[]
  locations     RideDriverLocation[]

  @@index([passengerId, createdAt])
  @@index([driverProfileId, createdAt])
  @@index([status, serviceType])
  @@map("ride_orders")
}

/// Catatan audit immutable untuk setiap transisi material.
model RideEvent {
  id             String           @id @default(uuid()) @db.Uuid
  rideOrderId    String           @map("ride_order_id") @db.Uuid
  type           RideEventType
  actorUserId    String?          @map("actor_user_id") @db.Uuid
  actorRole      RideActorRole    @map("actor_role")
  previousStatus RideOrderStatus? @map("previous_status")
  newStatus      RideOrderStatus? @map("new_status")
  /// Metadata yang sudah disanitasi (tanpa koordinat presisi / PII).
  metadata       Json?
  /// Identitas idempotensi event (mis. "<orderId>:<type>:<status>").
  eventKey       String           @unique @map("event_key") @db.VarChar(160)
  createdAt      DateTime         @default(now()) @map("created_at")

  rideOrder RideOrder @relation(fields: [rideOrderId], references: [id], onDelete: Cascade)
  actor     User?     @relation("RideEventActor", fields: [actorUserId], references: [id])

  @@index([rideOrderId, createdAt])
  @@index([type, createdAt])
  @@map("ride_events")
}

model RideDriverLocation {
  id              String   @id @default(uuid()) @db.Uuid
  driverProfileId String   @map("driver_profile_id") @db.Uuid
  rideOrderId     String?  @map("ride_order_id") @db.Uuid
  lat             Decimal  @db.Decimal(10, 7)
  lng             Decimal  @db.Decimal(10, 7)
  accuracyMeters  Int      @map("accuracy_meters")
  /// Nomor urut monotonik per driver untuk menolak update mundur.
  sequence        Int      @default(0)
  capturedAt      DateTime @map("captured_at")
  receivedAt      DateTime @default(now()) @map("received_at")

  driverProfile RideDriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  rideOrder     RideOrder?        @relation(fields: [rideOrderId], references: [id], onDelete: SetNull)

  @@index([driverProfileId, capturedAt])
  @@index([rideOrderId, capturedAt])
  @@map("ride_driver_locations")
}

/// Idempotency untuk operasi mutasi ride (quote/order/accept/complete).
model RideIdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  scope          String   @db.VarChar(60)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(120)
  userId         String   @map("user_id") @db.Uuid
  requestHash    String   @map("request_hash") @db.VarChar(64)
  resourceId     String?  @map("resource_id") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scope, userId, idempotencyKey])
  @@index([createdAt])
  @@map("ride_idempotency_records")
}

// ---------------------------------------------------------------------------
// Release 2 — domain PPOB (Stage R2.7: Foundation & Customer UI).
//
// Provider nyata (Digiflazz dsb.) sengaja BELUM diintegrasikan — itu ruang
// lingkup R2.8. Foundation ini mengunci katalog, alur pembelian, debit
// ppobBalance, ledger, idempotency, dan kompensasi refund yang aman-uang,
// dengan provider port yang hari ini hanya punya adapter stub.
// ---------------------------------------------------------------------------

enum PpobCategory {
  PULSA
  DATA
  PLN_PREPAID
  PLN_POSTPAID
  BPJS
  EWALLET
}

enum PpobTransactionStatus {
  /// Dibuat dan saldo sudah didebit; provider belum dipanggil.
  PENDING
  /// Provider menerima; pemenuhan belum final (dicadangkan untuk R2.8).
  PROCESSING
  /// Terpenuhi; serialNumber/token tersedia bila ada.
  SUCCESS
  /// Gagal; saldo SUDAH dikembalikan penuh lewat ledger PPOB_REFUND.
  FAILED
  /// Dibatalkan setelah sukses oleh koreksi admin (dicadangkan, belum ada alur).
  REFUNDED
}

/// Katalog produk PPOB yang dijual ke member. Harga adalah harga jual final
/// dalam rupiah; adminFee ditambahkan di atas harga saat checkout.
model PpobProduct {
  id           String            @id @default(uuid()) @db.Uuid
  /// Kode produk stabil yang dipakai klien, mis. PULSA_TSEL_10.
  sku          String            @unique @db.VarChar(40)
  category     PpobCategory
  /// Operator/penyedia layanan, mis. Telkomsel, PLN, BPJS Kesehatan.
  brand        String            @db.VarChar(40)
  name         String            @db.VarChar(120)
  description  String?           @db.VarChar(240)
  price        Decimal           @db.Decimal(14, 2)
  adminFee     Decimal           @default(0) @map("admin_fee") @db.Decimal(14, 2)
  isActive     Boolean           @default(true) @map("is_active")
  sortOrder    Int               @default(0) @map("sort_order")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  transactions PpobTransaction[]

  @@index([category, isActive, sortOrder])
  @@map("ppob_products")
}

model PpobTransaction {
  id              String @id @default(uuid()) @db.Uuid
  /// Referensi publik di API/UI (bukan UUID internal, tidak dapat ditebak).
  publicReference String @unique @map("public_reference") @db.VarChar(24)
  userId          String @map("user_id") @db.Uuid
  productId       String @map("product_id") @db.Uuid

  /// Snapshot produk saat beli: katalog boleh berubah, histori tidak ikut berubah.
  skuSnapshot         String       @map("sku_snapshot") @db.VarChar(40)
  productNameSnapshot String       @map("product_name_snapshot") @db.VarChar(120)
  brandSnapshot       String       @map("brand_snapshot") @db.VarChar(40)
  category            PpobCategory

  /// Nomor tujuan ternormalisasi (MSISDN 08…, IDPEL, nomor BPJS).
  targetNumber String @map("target_number") @db.VarChar(40)

  amount      Decimal @db.Decimal(14, 2)
  adminFee    Decimal @default(0) @map("admin_fee") @db.Decimal(14, 2)
  totalAmount Decimal @map("total_amount") @db.Decimal(14, 2)

  status            PpobTransactionStatus @default(PENDING)
  /// Nama adapter provider, hari ini selalu "stub".
  provider          String                @db.VarChar(20)
  providerReference String?               @map("provider_reference") @db.VarChar(64)
  /// Token PLN / serial number pulsa. Hanya disajikan ke pemilik transaksi.
  serialNumber      String?               @map("serial_number") @db.VarChar(120)
  failureCode       String?               @map("failure_code") @db.VarChar(40)
  failureReason     String?               @map("failure_reason") @db.VarChar(240)

  idempotencyKey      String? @map("idempotency_key") @db.VarChar(120)
  walletTransactionId String? @map("wallet_transaction_id") @db.Uuid
  refundTransactionId String? @map("refund_transaction_id") @db.Uuid

  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product PpobProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// NULL dianggap unik satu sama lain di Postgres, jadi transaksi tanpa key
  /// tidak pernah bertabrakan; key yang sama per user hanya boleh satu.
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("ppob_transactions")
}
