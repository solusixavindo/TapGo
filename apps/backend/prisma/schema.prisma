enum FounderRole {
  FOUNDER_CHAIRMAN
  FOUNDER_PLATINUM
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  role         UserRole      @default(USER)
  status       AccountStatus @default(ACTIVE)
  membershipId String?       @map("membership_id") @db.Uuid
  fullName     String        @db.VarChar(120)
  email        String?       @unique @db.VarChar(180)
  phone        String        @unique @db.VarChar(32)
  passwordHash String?       @map("password_hash")
  avatarUrl    String?       @map("avatar_url")
  bankAccount  Json?         @map("bank_account")
  referralCode String        @unique @map("referral_code") @db.VarChar(24)
  lastLoginAt  DateTime?     @map("last_login_at")

  /// Kepemilikan nomor telepon terbukti lewat OTP. NULL berarti belum
  /// terbukti — termasuk untuk akun legacy, yang SENGAJA tidak di-backfill.
  phoneVerifiedAt   DateTime? @map("phone_verified_at")
  /// Kepemilikan email terbukti lewat OTP. Email bersifat opsional; bila
  /// diisi tetapi NULL di sini, email tidak boleh dipakai sebagai recovery
  /// channel. Mengubah email mengosongkan kolom ini kembali.
  emailVerifiedAt   DateTime? @map("email_verified_at")
  /// Versi otorisasi akun. Setiap pencabutan sesi menaikkannya tepat satu.
  ///
  /// Inilah penentu otoritatif keabsahan token — BUKAN perbandingan waktu.
  /// Token membawa claim versi, dan requireAuth menuntut kesamaan persis.
  /// Pendekatan berbasis waktu tidak dapat memutuskan token yang diterbitkan
  /// pada detik yang sama dengan pencabutan, dan token semacam itu tetap sah
  /// sampai TTL-nya habis. Bilangan bulat tidak punya ambiguitas itu.
  authVersion       Int       @default(0) @map("auth_version")
  /// Epoch pencabutan sesi. Dipertahankan sebagai AUDIT TIMESTAMP saja —
  /// tidak lagi dipakai untuk keputusan otorisasi apa pun sejak Stage R2.1A.
  /// Keputusan otorisasi memakai authVersion.
  sessionsRevokedAt DateTime? @map("sessions_revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  membership                 Membership?                 @relation(fields: [membershipId], references: [id])
  driver                     Driver?
  sessions                   Session[]
  pushTokens                 PushToken[]
  rides                      Ride[]                      @relation("RideCustomer")
  wallet                     Wallet?
  reviewsGiven               Review[]                    @relation("ReviewsGiven")
  auditLogs                  AuditLog[]
  sponsoredReferrals         Referral[]                  @relation("ReferralSponsor")
  referralRecord             Referral?                   @relation("ReferralUser")
  referralAncestors          ReferralLevel[]             @relation("ReferralAncestor")
  referralDescendants        ReferralLevel[]             @relation("ReferralDescendant")
  commissions                Commission[]                @relation("CommissionBeneficiary")
  withdrawals                Withdrawal[]
  userMemberships            UserMembership[]
  membershipOrders           MembershipOrder[]
  invoices                   Invoice[]
  membershipPayments         MembershipPayment[]
  membershipDocuments        MembershipDocument[]
  profitSharingDistributions ProfitSharingDistribution[]
  rewardTransactions         RewardTransaction[]
  accountDeletionRequests    AccountDeletionRequest[]
  contactMessages            ContactMessage[]
  memberIdentity             MemberIdentity?
  supportTickets             SupportTicket[]
  supportTicketMessages      SupportTicketMessage[]
  registrationEvents         RegistrationEvent[]         @relation("RegistrationEventUser")
  abuseFlags                 AbuseFlag[]                 @relation("AbuseFlagUser")
  founderProgramGrants       FounderProgramGrant[]       @relation("FounderGrantUser")
  founderProgramGrantActions FounderProgramGrant[]       @relation("FounderGrantActor")
  authChallenges             AuthChallenge[]
  adminScopeGrants           AdminScopeGrant[]           @relation("AdminScopeSubject")
  adminScopeGrantsIssued     AdminScopeGrant[]           @relation("AdminScopeGrantor")
  adminScopeGrantsRevoked    AdminScopeGrant[]           @relation("AdminScopeRevoker")
  driverApplicationsClaimed  RideDriverApplication[]     @relation("DriverApplicationClaimant")
  driverApplicationsReviewed RideDriverApplication[]     @relation("DriverApplicationReviewer")

  // Release 2 — domain Ride (additive, terpisah dari model Ride legacy).
  rideDriverProfile      RideDriverProfile?
  rideQuotes             RideQuote[]
  ridePassengerOrders    RideOrder[]             @relation("RideOrderPassenger")
  rideEventsActed        RideEvent[]             @relation("RideEventActor")
  rideIdempotencyKeys    RideIdempotencyRecord[]
  rideDriverApplications RideDriverApplication[]

  // Release 2 — domain PPOB (Stage R2.7).
  ppobTransactions PpobTransaction[]

  @@index([role, status])
  @@index([membershipId])
  @@map("users")
}

/// Scope admin yang dibatasi. Sengaja berupa enum, BUKAN string bebas:
/// scope tak dikenal tidak akan pernah dapat tersimpan, dan wildcard tidak
/// dapat direpresentasikan sama sekali.
enum AdminScope {
  DRIVER_APPLICATION_QUEUE_READ
  DRIVER_APPLICATION_CLAIM
  DRIVER_APPLICATION_RENEW
  DRIVER_APPLICATION_RELEASE
  DRIVER_APPLICATION_REASSIGN
  /// Kewenangan mengelola scope lain. TIDAK pernah diberikan otomatis
  /// berdasarkan role, tidak pernah dibuat saat startup, migration, maupun
  /// seed. Pemegang pertama hanya dapat dibuat lewat CLI bootstrap sekali
  /// pakai; sesudahnya hanya SUPER_ADMIN aktif yang sudah memegangnya.
  ADMIN_SCOPE_MANAGE
}

enum AdminScopeGrantStatus {
  ACTIVE
  REVOKED
}

/// Pemberian scope admin yang otoritatif dari database.
///
/// Role saja TIDAK memberi kewenangan review. ADMIN maupun SUPER_ADMIN tetap
/// memerlukan grant aktif di tabel ini; tidak ada bypass berbasis role.
///
/// Riwayat dipertahankan penuh: pencabutan menandai baris REVOKED, tidak
/// pernah menghapusnya.
///
/// Objek raw SQL pada migration yang tidak boleh hilang:
///   - admin_scope_grants_one_active_per_scope_key (partial unique,
///     WHERE status = 'ACTIVE')
///   - admin_scope_grants_revocation_pair_check
model AdminScopeGrant {
  id     String                @id @default(uuid()) @db.Uuid
  userId String                @map("user_id") @db.Uuid
  scope  AdminScope
  status AdminScopeGrantStatus @default(ACTIVE)

  grantedById String   @map("granted_by_id") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at")

  revokedById String?   @map("revoked_by_id") @db.Uuid
  revokedAt   DateTime? @map("revoked_at")

  /// Kode alasan terbatas, BUKAN teks bebas dan bukan pesan exception.
  reasonCode String? @map("reason_code") @db.VarChar(60)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User  @relation("AdminScopeSubject", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy User  @relation("AdminScopeGrantor", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedBy User? @relation("AdminScopeRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId, scope, status])
  @@index([scope, status])
  @@map("admin_scope_grants")
}

enum AuthChallengePurpose {
  PASSWORD_RECOVERY
  PHONE_VERIFICATION
  EMAIL_VERIFICATION
}

enum AuthChallengeChannel {
  PHONE
  EMAIL
}

/// Satu tantangan OTP aktif per (user, purpose).
///
/// Berbeda dari OtpChallenge legacy yang masih ada di schema ini:
///   - terikat ke User, bukan ke string nomor telepon lepas;
///   - kode disimpan sebagai keyed HMAC dengan secret backend khusus, bukan
///     hash tanpa kunci — OTP hanya 10^6 kemungkinan sehingga hash tanpa
///     kunci dapat di-brute-force offline dari salinan database;
///   - destination ikut di-digest, jadi tabel ini tidak menyimpan PII;
///   - punya batas percobaan, cooldown kirim ulang, dan konsumsi atomik.
///
/// Objek yang dibuat lewat raw SQL pada migration dan tidak boleh hilang:
///   - auth_challenges_one_active_per_purpose_key (partial unique index,
///     WHERE consumed_at IS NULL)
///   - auth_challenges_attempts_check
///   - auth_challenges_max_attempts_check
///   - auth_challenges_resend_count_check
model AuthChallenge {
  id      String               @id @default(uuid()) @db.Uuid
  userId  String               @map("user_id") @db.Uuid
  purpose AuthChallengePurpose
  channel AuthChallengeChannel

  /// HMAC tujuan pengiriman. Nomor/email mentah TIDAK disimpan di sini.
  destinationDigest String @map("destination_digest")
  /// HMAC kode OTP. Kode mentah tidak pernah disimpan.
  codeDigest        String @map("code_digest")
  /// Versi kunci HMAC yang dipakai, agar rotasi secret dimungkinkan.
  keyVersion        Int    @default(1) @map("key_version")

  attempts    Int @default(0)
  maxAttempts Int @default(5) @map("max_attempts")
  resendCount Int @default(0) @map("resend_count")

  /// Diisi setelah OTP terbukti benar. Reset token hanya diterbitkan untuk
  /// purpose PASSWORD_RECOVERY.
  verifiedAt       DateTime? @map("verified_at")
  resetTokenDigest String?   @map("reset_token_digest")
  resetExpiresAt   DateTime? @map("reset_expires_at")

  lastSentAt DateTime  @default(now()) @map("last_sent_at")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
  @@map("auth_challenges")
}

model Membership {
  id            String         @id @default(uuid()) @db.Uuid
  tier          MembershipTier @unique
  name          String         @db.VarChar(80)
  price         Decimal        @default(0) @db.Decimal(14, 2)
  directBonus   Decimal        @default(0) @map("direct_bonus") @db.Decimal(14, 2)
  activeLevels  Int            @default(1) @map("active_levels")
  ppobBalance   Decimal        @default(0) @map("ppob_balance") @db.Decimal(14, 2)
  bpjsBenefit   String?        @map("bpjs_benefit")
  merchandise   Json?
  businessRight String?        @map("business_right")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  users                User[]
  benefits             MembershipBenefit[]
  userMemberships      UserMembership[]
  orders               MembershipOrder[]
  founderProgramGrants FounderProgramGrant[]

  @@index([tier, isActive])
  @@map("memberships")
}

model UserMembership {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  membershipId String               @map("membership_id") @db.Uuid
  orderId      String?              @unique @map("order_id") @db.Uuid
  status       UserMembershipStatus @default(ACTIVE)
  founderRole  FounderRole?         @map("founder_role")
  activeAt     DateTime             @default(now()) @map("active_at")
  expiresAt    DateTime?            @map("expires_at")
  metadata     Json?
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership          Membership           @relation(fields: [membershipId], references: [id])
  order               MembershipOrder?     @relation(fields: [orderId], references: [id])
  founderProgramGrant FounderProgramGrant?

  @@index([userId, status])
  @@index([membershipId, status])
  @@index([founderRole, status])
  @@map("user_memberships")
}

model FounderProgramGrant {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  membershipId     String      @map("membership_id") @db.Uuid
  userMembershipId String      @unique @map("user_membership_id") @db.Uuid
  founderRole      FounderRole @map("founder_role")
  grantedBy        String?     @map("granted_by") @db.Uuid
  reason           String?
  revokedAt        DateTime?   @map("revoked_at")
  revokedBy        String?     @map("revoked_by") @db.Uuid
  metadata         Json?
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  user           User           @relation("FounderGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  actor          User?          @relation("FounderGrantActor", fields: [grantedBy], references: [id], onDelete: SetNull)
  membership     Membership     @relation(fields: [membershipId], references: [id])
  userMembership UserMembership @relation(fields: [userMembershipId], references: [id], onDelete: Cascade)

  @@index([founderRole, revokedAt])
  @@index([userId, founderRole])
  @@index([grantedBy, createdAt])
  @@map("founder_program_grants")
}

model MembershipOrder {
  id               String                  @id @default(uuid()) @db.Uuid
  userId           String                  @map("user_id") @db.Uuid
  membershipId     String                  @map("membership_id") @db.Uuid
  status           MembershipOrderStatus   @default(PENDING)
  /// Null berarti order dibuat sebelum pelacakan kanal ada.
  channel          MembershipOrderChannel?
  totalAmount      Decimal                 @map("total_amount") @db.Decimal(14, 2)
  packageSnapshot  Json                    @map("package_snapshot")
  registrationData Json?                   @map("registration_data")
  expiresAt        DateTime?               @map("expires_at")
  paidAt           DateTime?               @map("paid_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership     Membership           @relation(fields: [membershipId], references: [id])
  invoice        Invoice?
  payments       MembershipPayment[]
  documents      MembershipDocument[]
  userMembership UserMembership?

  @@index([userId, status])
  @@index([membershipId, status])
  @@index([channel, status])
  @@map("membership_orders")
}

model Invoice {
  id        String        @id @default(uuid()) @db.Uuid
  orderId   String        @unique @map("order_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  number    String        @unique @db.VarChar(40)
  status    PaymentStatus @default(PENDING)
  amount    Decimal       @db.Decimal(14, 2)
  currency  String        @default("IDR") @db.VarChar(8)
  dueAt     DateTime?     @map("due_at")
  paidAt    DateTime?     @map("paid_at")
  metadata  Json?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  order    MembershipOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments MembershipPayment[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("invoices")
}

model MembershipPayment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  invoiceId         String        @map("invoice_id") @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(14, 2)
  method            String        @default("DEVELOPMENT_SIMULATOR") @db.VarChar(60)
  provider          String?       @db.VarChar(60)
  providerReference String?       @map("provider_reference") @db.VarChar(120)
  paidAt            DateTime?     @map("paid_at")
  metadata          Json?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  order   MembershipOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoice Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([orderId, status])
  @@index([providerReference])
  @@map("membership_payments")
}

/// Dokumen identitas untuk verifikasi keanggotaan.
///
/// Keputusan Owner (Stage R2.6 jalur A): berkasnya disimpan di database
/// aplikasi maksimal 24 jam. Dalam rentang itu admin mencetaknya menjadi
/// berkas administrasi, lalu isinya dihapus dari database.
///
/// Isi berkas TIDAK disimpan mentah. Yang tersimpan adalah ciphertext
/// AES-256-GCM; kuncinya berada di environment, bukan di database, supaya
/// salinan backup database saja tidak cukup untuk membukanya. Baris tetap
/// bertahan setelah isinya dihapus karena status dan jejak waktunya masih
/// dibutuhkan untuk audit.
model MembershipDocument {
  id          String                   @id @default(uuid()) @db.Uuid
  orderId     String                   @map("order_id") @db.Uuid
  userId      String                   @map("user_id") @db.Uuid
  type        MembershipDocumentType
  status      MembershipDocumentStatus @default(PENDING)
  url         String?
  localPath   String?                  @map("local_path")
  /// Ciphertext AES-256-GCM. Null berarti belum diunggah atau sudah dihapus.
  cipherText  Bytes?                   @map("cipher_text")
  cipherIv    Bytes?                   @map("cipher_iv")
  cipherTag   Bytes?                   @map("cipher_tag")
  /// Versi kunci aktif, disimpan bersama ciphertext agar rotasi mungkin.
  keyVersion  Int?                     @map("key_version")
  contentType String?                  @map("content_type") @db.VarChar(40)
  sizeBytes   Int?                     @map("size_bytes")
  /// SHA-256 isi asli. Dipakai membuktikan hasil cetak sama dengan yang diunggah.
  checksum    String?                  @db.VarChar(64)
  uploadedAt  DateTime?                @map("uploaded_at")
  /// Batas simpan. Setelah lewat, isi berkas tidak pernah disajikan lagi.
  expiresAt   DateTime?                @map("expires_at")
  purgedAt    DateTime?                @map("purged_at")
  metadata    Json?
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  order MembershipOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@index([userId, type])
  /// Dipakai penyapu berkala untuk menemukan dokumen yang sudah lewat masa simpan.
  @@index([expiresAt])
  @@map("membership_documents")
}

model MembershipBenefit {
  id             String   @id @default(uuid()) @db.Uuid
  membershipId   String   @map("membership_id") @db.Uuid
  level          Int
  commissionRate Decimal  @map("commission_rate") @db.Decimal(5, 2)
  fixedBonus     Decimal  @default(0) @map("fixed_bonus") @db.Decimal(14, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, level])
  @@index([level, isActive])
  @@map("membership_benefits")
}

model Referral {
  id        String         @id @default(uuid()) @db.Uuid
  sponsorId String         @map("sponsor_id") @db.Uuid
  userId    String         @unique @map("user_id") @db.Uuid
  status    ReferralStatus @default(ACTIVE)
  joinedAt  DateTime       @default(now()) @map("joined_at")
  blockedAt DateTime?      @map("blocked_at")
  metadata  Json?

  sponsor     User         @relation("ReferralSponsor", fields: [sponsorId], references: [id])
  user        User         @relation("ReferralUser", fields: [userId], references: [id], onDelete: Cascade)
  commissions Commission[]

  @@index([sponsorId, joinedAt])
  @@index([status])
  @@map("referrals")
}

model ReferralLevel {
  id           String   @id @default(uuid()) @db.Uuid
