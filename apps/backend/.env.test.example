NODE_ENV=test
# Integration tests must use a dedicated test database.
DATABASE_URL=postgresql://tapgo:tapgo_password@localhost:5433/tapgo_test?schema=public
TAPGO_TEST_DATABASE_URL=postgresql://tapgo:tapgo_password@localhost:5433/tapgo_test?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=tapgo_test_access_secret_64_chars_minimum_for_integration_tests
JWT_REFRESH_SECRET=tapgo_test_refresh_secret_64_chars_minimum_for_integration_tests
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000
MIDTRANS_SERVER_KEY=SB-Mid-server-test-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-test-key
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_NOTIFICATION_SECRET=
MIDTRANS_SNAP_URL=http://127.0.0.1:59999/snap/v1/transactions

# PPOB provider stub untuk integration test Stage R2.7.
PPOB_PROVIDER=stub

DIGIFLAZZ_USERNAME=tapgo_test_user
DIGIFLAZZ_API_KEY=tapgo_test_api_key
DIGIFLAZZ_TESTING=true
DIGIFLAZZ_WEBHOOK_SECRET=tapgo_test_webhook_secret_32chars
PPOB_RECONCILE_ENABLED=false
