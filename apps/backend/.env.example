NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://tapgo:tapgo_password@localhost:5432/tapgo?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace_with_64_char_access_secret
JWT_REFRESH_SECRET=replace_with_64_char_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
MIDTRANS_SERVER_KEY=midtrans_server_key
MIDTRANS_CLIENT_KEY=midtrans_client_key
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_NOTIFICATION_SECRET=
MIDTRANS_SNAP_URL=
EXTERNAL_MEMBERSHIP_PAYMENTS_ENABLED=false
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_API_KEY=
DOKU_PUBLIC_KEY=
DOKU_MERCHANT_PUBLIC_KEY=
DOKU_ENABLED=true
DOKU_INTEGRATION_MODE=checkout
DOKU_ENVIRONMENT=sandbox
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_WEBHOOK_SECRET=
DOKU_WEBHOOK_URL=https://api.tapgolion.id/api/v1/webhooks/doku
TAPGO_FOUNDER_CHAIRMAN_CONFIRM=
FOUNDER_CHAIRMAN_INITIAL_PASSWORD=
FOUNDER_CHAIRMAN_ACTOR_ID=
FOUNDER_CHAIRMAN_BANK_NAME=
FOUNDER_CHAIRMAN_BANK_ACCOUNT_NAME=
FOUNDER_CHAIRMAN_BANK_ACCOUNT_NUMBER=
CLOUDINARY_CLOUD_NAME=cloud_name
CLOUDINARY_API_KEY=api_key
CLOUDINARY_API_SECRET=api_secret
FIREBASE_PROJECT_ID=tapgo-prod
GOOGLE_MAPS_API_KEY=google_maps_api_key
# Identifier blind index (HMAC-SHA256) — backend only, JANGAN dipakai di mobile app.
# Terpisah dari JWT/payment/storage secret. Maksimal dua versi aktif.
IDENTIFIER_INDEX_KEY_CURRENT_VERSION=1
IDENTIFIER_INDEX_KEY_V1=replace_with_backend_only_random_min_32_chars
# IDENTIFIER_INDEX_KEY_V2 hanya diisi saat rotasi kunci (maksimal dua versi aktif).
# Biarkan baris ini tetap dikomentari bila belum rotasi — nilai kosong akan ditolak validasi.
# IDENTIFIER_INDEX_KEY_V2=

# Stage R2.7 PPOB: "disabled" (default) menolak pembelian dengan refund penuh;
# "stub" menyalakan provider sintetis deterministik untuk UAT.
# Provider nyata baru diterima mulai R2.8 — nilai tak dikenal menggagalkan boot.
PPOB_PROVIDER=disabled

# Stage R2.8 Digiflazz (kosong = provider tidak dapat di-resolve bila PPOB_PROVIDER=digiflazz).
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
# DIGIFLAZZ_BASE_URL diisi HANYA untuk stub server pada test/staging.
# DIGIFLAZZ_BASE_URL=
DIGIFLAZZ_TESTING=false
DIGIFLAZZ_WEBHOOK_SECRET=
PPOB_RECONCILE_ENABLED=false
PPOB_RECONCILE_INTERVAL_MS=60000
