NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://tapgo:tapgo_password@localhost:5432/tapgo?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace_with_64_char_access_secret
JWT_REFRESH_SECRET=replace_with_64_char_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Domain secrets (minimum 32 karakter, dan HARUS berbeda satu sama lain)
#
# Penegakannya fail-closed pada titik pemakaian, bukan saat boot: server tetap
# start tanpa mereka, tetapi fiturnya mati dengan 503. Tanpa
# MEMBERSHIP_DOCUMENT_SECRET, unggahan KTP/swafoto tidak akan pernah berhasil;
# tanpa AUTH_RECOVERY_HMAC_SECRET, pemulihan password tidak akan pernah berhasil.
#
# Bangkitkan masing-masing dengan:  openssl rand -base64 48
MEMBERSHIP_DOCUMENT_SECRET=replace_with_random_min_32_chars_document_secret
AUTH_RECOVERY_HMAC_SECRET=replace_with_random_min_32_chars_recovery_secret
MEMBERSHIP_DOCUMENT_RETENTION_HOURS=24
DRIVER_DOCUMENT_RETENTION_HOURS=24

# Rate limiter memakai Redis bila diisi. Kosong = penyimpanan dalam memori
# per-proses, yang hanya aman untuk deployment satu proses.
RATE_LIMIT_REDIS_URL=redis://localhost:6379

# --- Kanal & fitur (fail-closed)
# EXTERNAL_MEMBERSHIP_PAYMENTS_ENABLED adalah master switch untuk ketiga kanal.
EXTERNAL_MEMBERSHIP_PAYMENTS_ENABLED=false
MEMBERSHIP_PURCHASE_WEB_ENABLED=false
MEMBERSHIP_PURCHASE_APP_ENABLED=false
WALLET_CASH_OUT_ENABLED=false
REALTIME_ENABLED=false

MIDTRANS_SERVER_KEY=midtrans_server_key
MIDTRANS_CLIENT_KEY=midtrans_client_key
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_NOTIFICATION_SECRET=
MIDTRANS_SNAP_URL=
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_API_KEY=
DOKU_PUBLIC_KEY=
DOKU_MERCHANT_PUBLIC_KEY=
DOKU_ENABLED=true
DOKU_INTEGRATION_MODE=checkout
DOKU_ENVIRONMENT=sandbox
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_WEBHOOK_SECRET=
DOKU_WEBHOOK_URL=https://api.tapgolion.id/api/v1/webhooks/doku
TAPGO_FOUNDER_CHAIRMAN_CONFIRM=
FOUNDER_CHAIRMAN_INITIAL_PASSWORD=
FOUNDER_CHAIRMAN_ACTOR_ID=
FOUNDER_CHAIRMAN_BANK_NAME=
FOUNDER_CHAIRMAN_BANK_ACCOUNT_NAME=
FOUNDER_CHAIRMAN_BANK_ACCOUNT_NUMBER=
CLOUDINARY_CLOUD_NAME=cloud_name
CLOUDINARY_API_KEY=api_key
CLOUDINARY_API_SECRET=api_secret
FIREBASE_PROJECT_ID=tapgo-prod
GOOGLE_MAPS_API_KEY=google_maps_api_key
# Identifier blind index (HMAC-SHA256) — backend only, JANGAN dipakai di mobile app.
# Terpisah dari JWT/payment/storage secret. Maksimal dua versi aktif.
IDENTIFIER_INDEX_KEY_CURRENT_VERSION=1
IDENTIFIER_INDEX_KEY_V1=replace_with_backend_only_random_min_32_chars
# IDENTIFIER_INDEX_KEY_V2 hanya diisi saat rotasi kunci (maksimal dua versi aktif).
# Biarkan baris ini tetap dikomentari bila belum rotasi — nilai kosong akan ditolak validasi.
# IDENTIFIER_INDEX_KEY_V2=

# --- Seed akun demo. Diperlukan `npm run db:seed`, minimum 12 karakter.
# Password ini dulu ditanam harfiah di prisma/seed.ts yang ter-track di Git.
# Pakai nilai lokal Anda sendiri; jangan pernah menyetelnya di production.
SEED_ADMIN_PASSWORD=
SEED_DRIVER_PASSWORD=
SEED_USER_PASSWORD=
