<?xml version="1.0" encoding="utf-8"?>
<!--
  Ikon adaptif (Android 8+). Peluncur sendiri yang memotong bentuknya (bulat,
  persegi membulat, tetesan air, dst).

  Latar EMAS TapGo mengisi penuh kanvas 108dp. Lambang perisai singa-T resmi navy
  (dari logo 1280 px, tanpa mobil/motor/teks) diperbesar hingga hampir memenuhi
  area terlihat 72dp. Dibedakan dari ikon penumpang (latar navy, lambang emas).

  Lapisan monokrom dipakai ikon bertema Android 13+.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
