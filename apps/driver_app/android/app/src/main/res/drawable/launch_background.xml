<?xml version="1.0" encoding="utf-8"?>
<!-- Jendela peluncuran: gradasi biru tua yang SAMA dengan splash TapGo Driver di Flutter (splash_screen.dart),
     bukan putih polos (kilatan putih sebelum splash, terutama pada pemasangan pertama). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/tapgo_launch_start"
                android:endColor="@color/tapgo_launch_end"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
