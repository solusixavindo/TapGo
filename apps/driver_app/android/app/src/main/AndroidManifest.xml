<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Diperlukan untuk memotret dokumen verifikasi mitra. Hanya kamera dan
         pembacaan galeri; TIDAK ada izin tulis, karena aplikasi ini tidak
         pernah menyimpan berkas ke penyimpanan bersama. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Sengaja TANPA READ_MEDIA_IMAGES: image_picker memakai pemilih sistem
         (Photo Picker / SAF) yang tidak butuh izin baca galeri. Izin itu
         sebelumnya ikut terbawa padahal tidak dipakai (audit 4 Okt 2026). -->
    <!-- Verifikasi wajah hanya memotret (enableAudio: false), tidak pernah
         merekam suara. Plugin camera menambahkan RECORD_AUDIO lewat manifest
         merger; dibuang di sini supaya APK tidak meminta/menampilkan izin
         mikrofon yang tidak dipakai. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <!-- Peta live posisi driver di Beranda + kirim lokasi berkala ke backend
         selama online. Hanya foreground (whileInUse) — tidak ada klaim akses
         lokasi latar belakang. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Layanan latar depan (jenis lokasi) selama driver ONLINE atau punya
         perjalanan aktif, dengan notifikasi permanen. Bukan akses lokasi latar
         belakang saat offline. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application
        android:label="TapGo Driver"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">
        <!-- Audit keamanan 30 September 2026 (L3): tanpa ini, Android auto-backup
             bisa menyalin SharedPreferences/berkas app (termasuk sisa sesi/token
             sebelum EncryptedSharedPreferences berlaku penuh) ke cloud/adb backup
             milik pengguna — sama seperti user_app. -->

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="tapgo_alerts_v3" />
        <!-- Ikon kecil (siluet putih) dan warna aksen notifikasi FCM latar belakang;
             tanpa ini Android memakai ikon peluncur berwarna yang tampil sebagai
             gumpalan putih di bilah status. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_tapgo" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/tapgo_notification_accent" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
